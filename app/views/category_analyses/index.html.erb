<% content_for :page_header do %>
  <div class="space-y-4 mb-6">
    <header class="flex justify-between items-center text-primary font-medium gap-4">
      <div class="space-y-1">
        <h1 class="text-xl lg:text-3xl font-medium text-primary">
          <%= t("category_analyses.index.title") %>
        </h1>
        <p class="text-sm lg:text-base text-secondary">
          <%= t("category_analyses.index.subtitle") %>
        </p>
      </div>
    </header>

    <%# Period Selection Tabs %>
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <%= render DS::SegmentedControl.new(aria_label: t("category_analyses.index.period_aria"), class: "overflow-x-auto no-scrollbar") do |sc| %>
        <% %i[last_6_months last_12_months year_to_date custom].each do |ptype| %>
          <% sc.with_segment(t("category_analyses.index.periods.#{ptype}"),
               active: @period_type == ptype,
               href: category_analyses_path(period_type: ptype, category_ids: @selected_category_ids, account_ids: @selected_account_ids),
               class: "whitespace-nowrap") %>
        <% end %>
      <% end %>
    </div>

    <%# Custom Date Range Picker (only shown when custom is selected) %>
    <% if @period_type == :custom %>
      <%= form_with url: category_analyses_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex items-center gap-3 bg-surface-inset p-3 rounded-lg flex-wrap" do |f| %>
        <%= f.hidden_field :period_type, value: :custom %>
        <% @selected_category_ids.each do |id| %>
          <%= f.hidden_field :category_ids, multiple: true, value: id %>
        <% end %>
        <% @selected_account_ids.each do |id| %>
          <%= f.hidden_field :account_ids, multiple: true, value: id %>
        <% end %>

        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-secondary"><%= t("category_analyses.index.date_range.from") %></label>
          <%= f.date_field :start_date,
                           value: @period.start_date.strftime("%Y-%m-%d"),
                           data: { auto_submit_form_target: "auto" },
                           autocomplete: "off",
                           class: "px-3 py-1.5 border border-primary rounded-lg text-sm bg-container-inset text-primary" %>
        </div>
        <span class="text-secondary">—</span>
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-secondary"><%= t("category_analyses.index.date_range.to") %></label>
          <%= f.date_field :end_date,
                           value: @period.end_date.strftime("%Y-%m-%d"),
                           data: { auto_submit_form_target: "auto" },
                           autocomplete: "off",
                           class: "px-3 py-1.5 border border-primary rounded-lg text-sm bg-container-inset text-primary" %>
        </div>
      <% end %>
    <% end %>

    <%# Period Display and Navigation %>
    <% if @nav %>
      <div class="flex items-center gap-1 mb-4 flex-wrap">
        <div class="flex items-center gap-2">
          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-left",
            href: category_analyses_path(period_type: @period_type, start_date: @nav[:prev_start], end_date: @nav[:prev_end], category_ids: @selected_category_ids, account_ids: @selected_account_ids),
            aria: { label: t("category_analyses.index.previous_period") },
          ) if @nav[:prev_start] %>

          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-right",
            href: category_analyses_path(period_type: @period_type, start_date: @nav[:next_start], end_date: @nav[:next_end], category_ids: @selected_category_ids, account_ids: @selected_account_ids),
            aria: { label: t("category_analyses.index.next_period") },
          ) if @nav[:next_start] && !@nav[:at_latest] %>
        </div>

        <span class="text-primary font-medium text-lg lg:text-base"><%= @nav[:label] %></span>
      </div>
    <% end %>
  </div>
<% end %>

<div class="w-full space-y-6 lg:pb-6">
  <%# Filters: Categories + Accounts, all in one GET form so they submit together %>
  <section class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
      <h2 class="text-lg font-medium"><%= t("category_analyses.index.select_categories") %></h2>
    </div>

    <%= form_with url: category_analyses_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex flex-wrap items-center gap-3" do |f| %>
      <%= f.hidden_field :period_type, value: @period_type %>
      <% if @period_type == :custom %>
        <%= f.hidden_field :start_date, value: @period.start_date.strftime("%Y-%m-%d") %>
        <%= f.hidden_field :end_date, value: @period.end_date.strftime("%Y-%m-%d") %>
      <% end %>

      <%# Category dropdown %>
      <%= render DS::Popover.new(
            variant: "button",
            placement: "bottom-start",
            mobile_fullwidth: false,
            max_width: "20rem",
            aria_label: t("category_analyses.index.select_categories")
          ) do |popover| %>
        <% popover.with_button type: "button", class: "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium border border-primary rounded-lg hover:bg-surface-hover" do %>
          <%= icon("tags", size: "sm") %>
          <span><%= t("category_analyses.index.categories", count: @display_categories.size) %></span>
          <%= icon("chevron-down", size: "sm") %>
        <% end %>

        <% popover.with_custom_content do %>
          <div class="p-2 space-y-2" data-controller="list-filter">
            <div class="flex items-center gap-2 px-1">
              <%= link_to t("category_analyses.index.select_all"),
                    category_analyses_path(period_type: @period_type, account_ids: @selected_account_ids),
                    class: "text-xs font-medium text-secondary hover:text-primary px-2 py-1 rounded-md hover:bg-container-inset-hover" %>
              <span class="text-subdued">·</span>
              <%= link_to t("category_analyses.index.unselect_all"),
                    category_analyses_path(period_type: @period_type, category_ids: "none", account_ids: @selected_account_ids),
                    class: "text-xs font-medium text-secondary hover:text-primary px-2 py-1 rounded-md hover:bg-container-inset-hover" %>
            </div>

            <%= render DS::SearchInput.new(
                  variant: :embedded,
                  placeholder: t("category_analyses.index.search_placeholder"),
                  aria_label: t("category_analyses.index.search_placeholder"),
                  data: {
                    list_filter_target: "input",
                    action: "input->list-filter#filter"
                  }
                ) %>

            <div class="max-h-72 overflow-auto" data-list-filter-target="list" data-controller="category-tree">
              <% @category_options.each do |group| %>
                <% gid = group[:id].to_s %>
                <div class="filterable-item flex items-center gap-2 py-1.5 px-1" data-filter-name="<%= group[:name] %>">
                  <%= check_box_tag "category_ids[]",
                                    gid,
                                    @selected_category_ids.include?(gid),
                                    id: "category_#{gid}",
                                    class: "checkbox checkbox--light",
                                    data: {
                                      auto_submit_form_target: "auto",
                                      category_tree_target: "checkbox",
                                      action: "change->category-tree#toggle"
                                    } %>
                  <label for="category_<%= gid %>" class="flex items-center gap-1.5 cursor-pointer text-sm text-primary flex-1">
                    <% if group[:icon] %>
                      <%= icon(group[:icon], size: "sm", color: "current") %>
                    <% end %>
                    <span><%= group[:name] %></span>
                  </label>
                </div>

                <% group[:subcategories]&.each do |sub| %>
                  <% sid = sub[:id].to_s %>
                  <div class="filterable-item flex items-center gap-2 py-1.5 pl-5 px-1" data-filter-name="<%= sub[:name] %>">
                    <%= check_box_tag "category_ids[]",
                                      sid,
                                      @selected_category_ids.include?(sid),
                                      id: "category_#{sid}",
                                      class: "checkbox checkbox--light",
                                      data: {
                                        auto_submit_form_target: "auto",
                                        category_tree_target: "checkbox",
                                        parent_id: gid
                                      } %>
                    <label for="category_<%= sid %>" class="flex items-center gap-1.5 cursor-pointer text-sm text-secondary flex-1">
                      <%= icon("corner-down-right", size: "sm") %>
                      <% if sub[:icon] %>
                        <%= icon(sub[:icon], size: "sm", color: "current") %>
                      <% end %>
                      <span><%= sub[:name] %></span>
                    </label>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <%# Account dropdown %>
      <%= render DS::Popover.new(
            variant: "button",
            placement: "bottom-start",
            mobile_fullwidth: false,
            max_width: "20rem",
            aria_label: t("category_analyses.index.select_accounts")
          ) do |popover| %>
        <% popover.with_button type: "button", class: "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium border border-secondary rounded-lg text-primary hover:bg-surface-hover" do %>
          <%= icon("list-filter", size: "sm") %>
          <span><%= @all_accounts_selected ? t("category_analyses.index.filter_accounts_all") : t("category_analyses.index.filter_accounts", count: @selected_account_ids.size) %></span>
          <%= icon("chevron-down", size: "sm") %>
        <% end %>

        <% popover.with_custom_content do %>
          <div class="p-2 space-y-2" data-controller="list-filter">
            <%= render DS::SearchInput.new(
                  variant: :embedded,
                  placeholder: t("category_analyses.index.search_accounts"),
                  aria_label: t("category_analyses.index.search_accounts"),
                  data: {
                    list_filter_target: "input",
                    action: "input->list-filter#filter"
                  }
                ) %>

            <div class="max-h-64 overflow-auto" data-list-filter-target="list">
              <% @accounts.each do |account| %>
                <% aid = account.id.to_s %>
                <label class="filterable-item flex items-center gap-2 p-1.5 rounded-md hover:bg-container-inset-hover cursor-pointer" data-filter-name="<%= account.name %>">
                  <%= check_box_tag "account_ids[]",
                                    aid,
                                    @selected_account_ids.include?(aid),
                                    class: "checkbox checkbox--light",
                                    data: { auto_submit_form_target: "auto" } %>
                  <span class="text-sm text-primary truncate"><%= account.name %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <%# Chart Section %>
  <section class="bg-container rounded-xl shadow-border-xs p-4">
    <h2 class="text-lg font-medium mb-4"><%= t("category_analyses.index.chart_title") %></h2>

    <% if @monthly_data.any? { |m| m[:segments].any? } %>
      <div class="relative"
        data-controller="category-histogram"
        data-category-histogram-data-value="<%= @monthly_data.to_json %>"
        data-category-histogram-currency-value="<%= Current.family.currency %>">
        <div class="h-[400px] lg:h-[500px]">
          <div data-category-histogram-target="chartContainer" class="absolute inset-0"></div>
        </div>
        <div data-category-histogram-target="legend" class="flex flex-wrap gap-x-3 gap-y-1.5 mt-4 pt-4 border-t border-tertiary"></div>
      </div>
    <% else %>
      <div class="text-center py-8 text-subdued">
        <%= t("category_analyses.index.no_data") %>
      </div>
    <% end %>
  </section>

  <%# Donut: breakdown by category for a selected month %>
  <% if @monthly_data.any? { |m| m[:segments].any? } %>
    <section class="bg-container rounded-xl shadow-border-xs p-4">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h2 class="text-lg font-medium"><%= t("category_analyses.index.donut_title") %></h2>

        <%= render DS::Menu.new(variant: :button, placement: "bottom-end", max_height: "18rem") do |menu| %>
          <% menu.with_button(type: "button", class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium border border-secondary rounded-lg text-primary hover:bg-surface-hover") do %>
            <span class="capitalize"><%= I18n.l(@donut_month, format: :month_year) %></span>
            <%= icon("chevron-down", size: "sm") %>
          <% end %>

          <% @monthly_data.each do |m| %>
            <% menu.with_item(
                 variant: :link,
                 text: I18n.l(m[:month], format: :month_year).capitalize,
                 href: category_analyses_path(period_type: @period_type, category_ids: @selected_category_ids, account_ids: @selected_account_ids, donut_month: m[:month]),
                 selected: m[:month] == @donut_month
               ) %>
          <% end %>
        <% end %>
      </div>

      <% if @donut_segments.any? %>
        <div class="flex flex-col lg:flex-row gap-8 items-center">
          <div class="w-full lg:w-1/3 max-w-[300px] px-4">
            <div class="h-[300px] relative"
              data-controller="donut-chart"
              data-donut-chart-segments-value="<%= @donut_segments.to_json %>"
              data-donut-chart-segment-opacity-value="0.9"
              data-donut-chart-extended-hover-value="true"
              data-donut-chart-hover-extension-value="3"
              data-donut-chart-enable-click-value="false">
              <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

              <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
                <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
                  <div class="text-secondary text-sm mb-2">
                    <span><%= t("category_analyses.index.donut_total") %></span>
                  </div>
                  <div data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                    <%= format_money Money.new(@donut_total, Current.family.currency) %>
                  </div>
                </div>

                <% @donut_segments.each do |category| %>
                  <div id="segment_<%= category[:id] %>" class="hidden">
                    <div class="flex flex-col gap-2 items-center">
                      <p class="text-sm text-secondary"><%= category[:name] %></p>
                      <p data-donut-chart-target="amount" class="text-3xl font-medium text-primary privacy-sensitive whitespace-nowrap">
                        <%= format_money Money.new(category[:amount], Current.family.currency) %>
                      </p>
                      <p class="text-sm text-secondary privacy-sensitive"><%= category[:percentage] %>%</p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="w-full lg:w-2/3 bg-container-inset rounded-xl p-1 space-y-1 overflow-x-auto">
            <div class="px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
              <div class="w-16 lg:w-40">
                <p><%= t("category_analyses.index.select_categories") %><span class="text-subdued mx-1">&middot;</span><%= @donut_segments.count %></p>
              </div>
              <div class="ml-auto text-right flex items-center gap-6">
                <div class="w-16 lg:w-40">
                  <p><%= t("category_analyses.index.table.total") %></p>
                </div>
                <div class="w-16">
                  <p>%</p>
                </div>
              </div>
            </div>
            <div class="py-3 shadow-border-xs rounded-lg bg-container font-medium text-sm max-w-full">
              <% @donut_segments.each_with_index do |category, idx| %>
                <div class="flex items-center justify-between mx-3 p-3 rounded-lg group gap-3"
                    data-category-id="<%= category[:id] %>"
                    data-action="mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment">
                  <div class="flex items-center gap-3 flex-1 min-w-0">
                    <div class="h-7 w-7 flex-shrink-0 group-hover:scale-105 transition-all duration-300 rounded-full flex justify-center items-center"
                      style="background-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent); border-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent); color: <%= category[:color] %>;">
                      <% if category[:icon] %>
                        <%= icon(category[:icon], color: "current", size: "sm") %>
                      <% else %>
                        <%= render DS::FilledIcon.new(variant: :text, hex_color: category[:color], text: category[:name], size: "sm", rounded: true) %>
                      <% end %>
                    </div>
                    <span class="text-sm font-medium text-primary truncate"><%= category[:name] %></span>
                  </div>
                  <div class="flex items-center gap-4 flex-shrink-0 text-right">
                    <span class="text-sm font-medium text-primary whitespace-nowrap privacy-sensitive"><%= format_money Money.new(category[:amount], Current.family.currency) %></span>
                    <span class="text-sm text-secondary whitespace-nowrap w-10 lg:w-15 privacy-sensitive"><%= category[:percentage] %>%</span>
                  </div>
                </div>
                <% if idx < @donut_segments.size - 1 %>
                  <%= render "shared/ruler", classes: "mx-3 lg:mx-4" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="text-center py-8 text-subdued">
          <%= t("category_analyses.index.donut_empty") %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# Comparison vs. previous period %>
  <% if @comparison_data[:available] && @comparison_data[:rows].any? %>
    <section class="bg-container rounded-xl shadow-border-xs p-4">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h2 class="text-lg font-medium"><%= t("category_analyses.index.comparison_title") %></h2>
        <p class="text-sm text-secondary">
          <%= t("category_analyses.index.comparison_subtitle",
                previous: @comparison_data[:previous_label],
                current: @comparison_data[:current_label]) %>
        </p>
      </div>

      <%# Summary cards %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="p-4 bg-surface-inset rounded-lg">
          <p class="text-sm text-secondary mb-1"><%= @comparison_data[:previous_label] %></p>
          <p class="text-lg font-semibold text-primary privacy-sensitive tabular-nums">
            <%= format_money Money.new(@comparison_data[:previous_total], Current.family.currency) %>
          </p>
        </div>
        <div class="p-4 bg-surface-inset rounded-lg">
          <p class="text-sm text-secondary mb-1"><%= @comparison_data[:current_label] %></p>
          <p class="text-lg font-semibold text-primary privacy-sensitive tabular-nums">
            <%= format_money Money.new(@comparison_data[:current_total], Current.family.currency) %>
          </p>
        </div>
        <div class="p-4 bg-surface-inset rounded-lg">
          <p class="text-sm text-secondary mb-1"><%= t("category_analyses.index.comparison_change") %></p>
          <p class="text-lg font-semibold privacy-sensitive tabular-nums <%= @comparison_data[:total_change] > 0 ? 'text-destructive' : (@comparison_data[:total_change] < 0 ? 'text-success' : 'text-primary') %>">
            <%= format_money Money.new(@comparison_data[:total_change].abs, Current.family.currency) %>
            <span class="text-sm font-medium">
              <% if @comparison_data[:total_pct] > 0 %>
                (+<%= @comparison_data[:total_pct] %>%)
              <% elsif @comparison_data[:total_pct] < 0 %>
                (<%= @comparison_data[:total_pct] %>%)
              <% else %>
                (0%)
              <% end %>
            </span>
          </p>
        </div>
      </div>

      <%# Per-category comparison table %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-secondary uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3 text-left font-medium"><%= t("category_analyses.index.comparison_table.category") %></th>
              <th class="px-4 py-3 text-right font-medium whitespace-nowrap"><%= @comparison_data[:previous_label] %></th>
              <th class="px-4 py-3 text-right font-medium whitespace-nowrap"><%= @comparison_data[:current_label] %></th>
              <th class="px-4 py-3 text-right font-medium"><%= t("category_analyses.index.comparison_table.change") %></th>
              <th class="px-4 py-3 text-right font-medium"><%= t("category_analyses.index.comparison_table.percent") %></th>
            </tr>
          </thead>
          <tbody class="text-primary">
            <% @comparison_data[:rows].each_with_index do |row, idx| %>
              <tr class="<%= cycle('bg-container', 'bg-container-inset') %>">
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <span class="h-3 w-3 rounded-full shrink-0" style="background-color: <%= row[:color] %>;"></span>
                    <% if row[:icon] %>
                      <%= icon(row[:icon], size: "sm", color: "current") %>
                    <% end %>
                    <span class="font-medium"><%= row[:name] %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-right privacy-sensitive tabular-nums text-secondary">
                  <%= format_money Money.new(row[:previous], Current.family.currency) %>
                </td>
                <td class="px-4 py-3 text-right privacy-sensitive tabular-nums font-medium">
                  <%= format_money Money.new(row[:current], Current.family.currency) %>
                </td>
                <td class="px-4 py-3 text-right privacy-sensitive tabular-nums <%= row[:change] > 0 ? 'text-destructive' : (row[:change] < 0 ? 'text-success' : 'text-subdued') %>">
                  <% if row[:change] > 0 %>
                    +<%= format_money Money.new(row[:change], Current.family.currency) %>
                  <% elsif row[:change] < 0 %>
                    −<%= format_money Money.new(row[:change].abs, Current.family.currency) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right privacy-sensitive tabular-nums <%= row[:change] > 0 ? 'text-destructive' : (row[:change] < 0 ? 'text-success' : 'text-subdued') %>">
                  <% if row[:change] > 0 %>
                    +<%= row[:pct] %>%
                  <% elsif row[:change] < 0 %>
                    <%= row[:pct] %>%
                  <% else %>
                    —
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <%# Anomaly detection %>
  <% if @anomalies.any? %>
    <section class="bg-container rounded-xl shadow-border-xs p-4">
      <h2 class="text-lg font-medium mb-2"><%= t("category_analyses.index.anomaly_title") %></h2>
      <p class="text-sm text-secondary mb-4"><%= t("category_analyses.index.anomaly_subtitle") %></p>

      <div class="space-y-2">
        <% @anomalies.each do |anomaly| %>
          <div class="flex items-center justify-between p-3 rounded-lg bg-container-inset gap-3">
            <div class="flex items-center gap-2 min-w-0 flex-1">
              <span class="h-3 w-3 rounded-full shrink-0" style="background-color: <%= anomaly[:color] %>;"></span>
              <% if anomaly[:icon] %>
                <%= icon(anomaly[:icon], size: "sm", color: "current") %>
              <% end %>
              <span class="text-sm font-medium text-primary truncate"><%= anomaly[:name] %></span>
            </div>

            <div class="flex items-center gap-4 flex-shrink-0 text-right">
              <div class="text-right">
                <p class="text-xs text-secondary"><%= t("category_analyses.index.anomaly_average") %></p>
                <p class="text-sm text-secondary tabular-nums privacy-sensitive"><%= format_money Money.new(anomaly[:average], Current.family.currency) %></p>
              </div>
              <div class="text-right">
                <p class="text-xs text-secondary"><%= t("category_analyses.index.anomaly_latest") %></p>
                <p class="text-sm font-medium tabular-nums privacy-sensitive"><%= format_money Money.new(anomaly[:latest], Current.family.currency) %></p>
              </div>
              <div class="text-right min-w-[80px]">
                <% if anomaly[:direction] == :up %>
                  <span class="inline-flex items-center gap-1 text-sm text-destructive tabular-nums">
                    <%= icon("arrow-up-right", size: "sm") %>
                    +<%= anomaly[:pct_dev] %>%
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 text-sm text-success tabular-nums">
                    <%= icon("arrow-down-right", size: "sm") %>
                    <%= anomaly[:pct_dev] %>%
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Top-N "where does my money go" %>
  <% if @top_categories.is_a?(Hash) && @top_categories[:rows]&.any? %>
    <section class="bg-container rounded-xl shadow-border-xs p-4">
      <h2 class="text-lg font-medium mb-4"><%= t("category_analyses.index.top_title") %></h2>

      <div class="space-y-1">
        <% @top_categories[:rows].each_with_index do |row, idx| %>
          <div class="flex items-center gap-3 p-3 rounded-lg group hover:bg-container-inset-hover">
            <span class="w-6 text-sm font-medium text-subdued tabular-nums text-right"><%= idx + 1 %></span>

            <div class="h-7 w-7 flex-shrink-0 rounded-full flex justify-center items-center"
              style="background-color: color-mix(in oklab, <%= row[:color] %> 10%, transparent); color: <%= row[:color] %>;">
              <% if row[:icon] %>
                <%= icon(row[:icon], color: "current", size: "sm") %>
              <% end %>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-3">
                <span class="text-sm font-medium text-primary truncate"><%= row[:name] %></span>
                <span class="text-sm font-medium text-primary tabular-nums privacy-sensitive whitespace-nowrap"><%= format_money Money.new(row[:amount], Current.family.currency) %></span>
              </div>
              <div class="mt-1.5 flex items-center gap-2">
                <div class="h-2 rounded-full bg-container-inset flex-1 overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-500" style="width: <%= row[:percentage] %>%; background-color: <%= row[:color] %>;"></div>
                </div>
                <span class="text-xs text-secondary tabular-nums w-12 text-right"><%= row[:percentage] %>%</span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-4 pt-4 border-t border-tertiary flex items-center justify-between">
        <span class="text-sm text-secondary"><%= t("category_analyses.index.top_total") %></span>
        <span class="text-lg font-semibold text-primary tabular-nums privacy-sensitive"><%= format_money Money.new(@top_categories[:total], Current.family.currency) %></span>
      </div>
    </section>
  <% end %>

  <%# Monthly Breakdown Table %>
  <section class="bg-container rounded-xl shadow-border-xs p-4">
    <h2 class="text-lg font-medium mb-4"><%= t("category_analyses.index.table_title") %></h2>

    <% if @monthly_data.any? { |m| m[:segments].any? } %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-secondary uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3 text-left font-medium"><%= t("category_analyses.index.table.month") %></th>
              <% @display_categories.each do |category| %>
                <th class="px-4 py-3 text-right font-medium whitespace-nowrap"><%= category.display_name %></th>
              <% end %>
              <th class="px-4 py-3 text-right font-medium"><%= t("category_analyses.index.table.total") %></th>
            </tr>
          </thead>
          <tbody class="text-primary">
            <% @monthly_data.each do |month_data| %>
              <tr class="<%= cycle('bg-container', 'bg-container-inset') %>">
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="<%= month_data[:is_current] ? 'font-medium' : '' %>">
                    <%= month_data[:month_label] %>
                  </span>
                  <% if month_data[:is_current] %>
                    <span class="text-xs text-subdued ml-1">(<%= t("category_analyses.index.current_month") %>)</span>
                  <% end %>
                </td>

                <% month_total = 0 %>
                <% @display_categories.each do |category| %>
                  <% seg = month_data[:segments].find { |s| s[:category_id] == category.id } %>
                  <% value = seg ? seg[:value] : 0 %>
                  <% month_total += value %>

                  <td class="px-4 py-3 text-right privacy-sensitive tabular-nums">
                    <% if value > 0 %>
                      <span class="text-primary"><%= format_money Money.new(value, Current.family.currency) %></span>
                    <% else %>
                      <span class="text-subdued"><%= format_money Money.new(0, Current.family.currency) %></span>
                    <% end %>
                  </td>
                <% end %>

                <td class="px-4 py-3 text-right font-medium privacy-sensitive tabular-nums">
                  <%= format_money Money.new(month_total, Current.family.currency) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8 text-subdued">
        <%= t("category_analyses.index.no_data") %>
      </div>
    <% end %>
  </section>
</div>
